        fi

        # Authentication on a listener without mandatory TLS sends passwords in clear text
        FIND=$(${GREPBINARY} -E '^[[:space:]]*listen[[:space:]]+on.*[[:space:]]auth([[:space:]]|$)' "${OPENSMTPD_CONF}" | ${GREPBINARY} -vE '[[:space:]](tls-require|smtps)([[:space:]]|$)')
        if [ -n "${FIND}" ]; then
            Display --indent 6 --text "- OpenSMTPD authentication without TLS" --result "${STATUS_WARNING}" --color RED
            ReportWarning "${TEST_NO}" "OpenSMTPD allows authentication without mandatory TLS" "${FIND}" "text:Use tls-require or smtps on listeners with auth"
        fi
    fi
