#
# E-mail and messaging (enhanced version)
#
# Changes compared to the upstream file (see DESCRIPTION.md for details):
#   - Fixed: OpenSMTPD not reported as smtp_daemon, qmail detection on idle
#     servers, wrong Exim option name (tls_verify_certificates), Exim values
#     containing '=', GNU-only sed syntax, Postfix tests running without postconf
#   - Added: Exim banner (MAIL-8806), Postfix relay (MAIL-8822) and TLS
#     (MAIL-8824), Dovecot configuration (MAIL-8840), Sendmail privacy options
#     and banner (MAIL-8882), OpenSMTPD configuration (MAIL-8922), multiple
#     MTAs (MAIL-8930), private key permissions and hardening points
#
#################################################################################
#
    InsertSection "${SECTION_EMAIL_AND_MESSAGING}"
#
#################################################################################
#
    DOVECOT_RUNNING=0
    DOVECONFBINARY=""
    EXIM_RUNNING=0
    EXIM_TYPE=""
    IMAP_DAEMON=""
    MTA_RUNNING_COUNT=0
    MTA_RUNNING_LIST=""
    OPENSMTPD_RUNNING=0
    POP3_DAEMON=""
    POSTFIX_RUNNING=0
    POSTFIX_SETTINGS=""
    QMAIL_RUNNING=0
    SENDMAIL_RUNNING=0
    SMTP_DAEMON=""
#
#################################################################################
#
    # Helper functions for this test group

    # Register a running MTA. Keeps a list of all MTAs instead of only the last one
    MailAddMTA() {
        SMTP_DAEMON="$1"
        MTA_RUNNING_COUNT=$((MTA_RUNNING_COUNT + 1))
        MTA_RUNNING_LIST="${MTA_RUNNING_LIST}${MTA_RUNNING_LIST:+ }$1"
        Report "smtp_daemon[]=$1"
    }

    # Value of an Exim main option. 'exim -bP -n' prints only the value, so values that contain '=' stay intact.
    # Exim prints "<name> is not a known option" on stdout, which should never be used as a value
    MailEximOption() {
        ${EXIMBINARY} -bP -n "$1" 2> /dev/null | ${GREPBINARY} -v "is not a known option"
    }

    # Value of an option of an Exim transport ($1 = transport, $2 = option)
    MailEximTransportOption() {
        ${EXIMBINARY} -bP transport "$1" 2> /dev/null | ${AWKBINARY} -v opt="$2" '{ sub(/^[ \t]+/, "") } index($0, opt " =") == 1 { sub(/^[^=]*=[ \t]*/, ""); print; exit }'
    }

    # Value of a Postfix parameter, taken from the cached output of postconf
    MailPostfixValue() {
        echo "${POSTFIX_SETTINGS}" | ${AWKBINARY} -v key="$1" '$1 == key { sub(/^[^=]*= ?/, ""); print; exit }'
    }

    # Check that a private key is not accessible by other users
    # $1 = test ID, $2 = service name, $3 = file, $4 = indent
    MailCheckPrivateKey() {
        if [ -f "$3" ]; then
            KEYPERMS=$(${LSBINARY} -lL "$3" 2> /dev/null | ${CUTBINARY} -c 8-10)
            if [ "${KEYPERMS}" = "---" ]; then
                LogText "Result: private key $3 is not accessible by other users"
                Display --indent $4 --text "- Private key permissions" --result "${STATUS_OK}" --color GREEN
                AddHP 2 2
            else
                LogText "Result: private key $3 is accessible by other users (permissions for others: ${KEYPERMS})"
                Display --indent $4 --text "- Private key permissions" --result "${STATUS_UNSAFE}" --color RED
                ReportWarning "$1" "$2 private key is accessible by other users" "$3" "text:Run chmod o-rwx $3"
                AddHP 0 2
            fi
        fi
    }
#
#################################################################################
#
    # Test        : MAIL-8802
    # Description : Check Exim process status
    Register --test-no MAIL-8802 --weight L --network NO --category security --description "Check Exim status"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: check Exim status"
        if IsRunning "exim4" || IsRunning "exim"; then
            LogText "Result: found running Exim process"
            Display --indent 2 --text "- Exim status" --result "${STATUS_RUNNING}" --color GREEN
            EXIM_RUNNING=1
            MailAddMTA "exim"
        else
            LogText "Result: no running Exim processes found"
            if IsVerbose; then Display --indent 2 --text "- Exim status" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8804
    # Description : Exim configuration options
    if [ ${EXIM_RUNNING} -eq 1 -a -n "${EXIMBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8804 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Exim configuration options"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: Exim configuration options"

        unset FIND FIND2 FIND3 FIND4

        # Debian and Ubuntu store the configuration type selected with dpkg-reconfigure
        EXIM_DEBCONF="/etc/exim4/update-exim4.conf.conf"
        if [ -f "${EXIM_DEBCONF}" ]; then
            FIND=$(${GREPBINARY} "^dc_eximconfig_configtype=" "${EXIM_DEBCONF}" | ${CUTBINARY} -d '=' -f2 | ${TRBINARY} -d "'\"")
            case "${FIND}" in
                "internet")  EXIM_TYPE="INTERNET HOST" ;;
                "local")     EXIM_TYPE="LOCAL ONLY" ;;
                "smarthost") EXIM_TYPE="SMARTHOST" ;;
                "satellite") EXIM_TYPE="SATELLITE" ;;
            esac
            if [ -n "${EXIM_TYPE}" ]; then LogText "Result: configuration type '${FIND}' found in ${EXIM_DEBCONF}"; fi
        fi

        # Otherwise derive the type from the names of the routers
        EXIM_ROUTERS=$(${EXIMBINARY} -bP router_list 2> /dev/null)
        if [ -z "${EXIM_TYPE}" ]; then
            # Local Only
            FIND=$(echo "${EXIM_ROUTERS}" | ${GREPBINARY} -E '^nonlocal')
            # Internet Host
            FIND2=$(echo "${EXIM_ROUTERS}" | ${GREPBINARY} -E '^dnslookup_relay_to_domains')
            # Smarthost or Satellite
            FIND3=$(echo "${EXIM_ROUTERS}" | ${GREPBINARY} -E '^smarthost')

            if [ -n "${FIND}" ]; then
                EXIM_TYPE="LOCAL ONLY"
            elif [ -n "${FIND2}" ]; then
                EXIM_TYPE="INTERNET HOST"
            elif [ -n "${FIND3}" ]; then
                FIND4=$(echo "${EXIM_ROUTERS}" | ${GREPBINARY} -E '^hub_user_smarthost')
                if [ -n "${FIND4}" ]; then
                    EXIM_TYPE="SATELLITE"
                else
                    EXIM_TYPE="SMARTHOST"
                fi
            else
                # Non-Debian configurations (e.g. the default 'configure' file) use a router named dnslookup
                FIND=$(echo "${EXIM_ROUTERS}" | ${GREPBINARY} -E '^dnslookup')
                if [ -n "${FIND}" ]; then EXIM_TYPE="INTERNET HOST"; fi
            fi
        fi

        if [ -n "${EXIM_TYPE}" ]; then
            LogText "Result: Exim Type - ${EXIM_TYPE}"
            Display --indent 4 --text "- Type" --result "${EXIM_TYPE}" --color GREEN
            Report "exim_type=${EXIM_TYPE}"
        else
            LogText "Result: Exim Type - Not Configured"
            Display --indent 4 --text "- Type" --result "${STATUS_NOT_CONFIGURED}" --color WHITE
        fi

        if [ "${EXIM_TYPE}" = "INTERNET HOST" -o "${EXIM_TYPE}" = "SMARTHOST" ]; then
            LogText "Test: Exim Public Interfaces"
            EXIM_INTERFACES=$(MailEximOption local_interfaces)
            # Lists may start with a custom separator, like "<; 0.0.0.0 ; ::0"
            case "${EXIM_INTERFACES}" in
                "<"*)
                    EXIM_SEP=$(echo "${EXIM_INTERFACES}" | ${CUTBINARY} -c 2)
                    EXIM_LIST=$(echo "${EXIM_INTERFACES}" | ${CUTBINARY} -c 3-)
                    ;;
                *)
                    EXIM_SEP=":"
                    EXIM_LIST="${EXIM_INTERFACES}"
                    ;;
            esac
            EXIM_IP=$(echo "${EXIM_LIST}" | ${AWKBINARY} -F "${EXIM_SEP}" '{ for (i = 1; i <= NF; i++) { gsub(/^[ \t]+|[ \t]+$/, "", $i); if ($i != "" && $i != "127.0.0.1" && $i != "::1") printf "%s%s", (n++ ? " " : ""), $i } }')
            if [ -z "${EXIM_INTERFACES}" ]; then
                # An unset local_interfaces means Exim listens on all interfaces
                EXIM_IP="ALL"
            fi
            if [ -n "${EXIM_IP}" ]; then
                LogText "Result: ${EXIM_IP}"
                Display --indent 4 --text "- Public Interface(s)" --result "${EXIM_IP}" --color GREEN
                Report "exim_public_interfaces=${EXIM_IP}"
            else
                LogText "Result: None"
                Display --indent 4 --text "- Public Interface(s)" --result "${STATUS_NONE}" --color WHITE
            fi

            LogText "Test: Exim TLS State"
            EXIM_TLS=$(MailEximOption tls_advertise_hosts)
            EXIM_CERTIFICATE=$(MailEximOption tls_certificate)
            if [ -z "${EXIM_TLS}" ]; then
                LogText "Result: TLS is not advertised"
                Display --indent 4 --text "- TLS" --result "${STATUS_DISABLED}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Enable TLS in Exim, so mail can be received encrypted" "tls_advertise_hosts=" "text:Set tls_advertise_hosts, tls_certificate and tls_privatekey"
                AddHP 0 3
            elif [ -z "${EXIM_CERTIFICATE}" ]; then
                # tls_advertise_hosts defaults to '*' (since 4.85), so TLS is 'on' even when no certificate exists
                LogText "Result: TLS is advertised (${EXIM_TLS}), but no certificate is configured"
                Display --indent 4 --text "- TLS" --result "NO CERTIFICATE" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Exim advertises TLS without a configured certificate, so clients get a temporary self-signed certificate at best" "tls_certificate=" "text:Configure tls_certificate and tls_privatekey (e.g. MAIN_TLS_ENABLE on Debian)"
                AddHP 1 3
            else
                LogText "Result: Enabled"
                Display --indent 4 --text "- TLS" --result "${STATUS_ENABLED}" --color GREEN
                AddHP 3 3
            fi
        fi

        if [ -n "${EXIM_TYPE}" -a "${EXIM_TYPE}" != "LOCAL ONLY" ]; then
            LogText "Test: Exim Certificate and Private Key"

            case "${EXIM_TYPE}" in
                "INTERNET HOST" | "SMARTHOST" )
                    EXIM_CERTIFICATE=$(MailEximOption tls_certificate)
                    EXIM_PRIVATEKEY=$(MailEximOption tls_privatekey)
                    ;;
                "SATELLITE" )
                    EXIM_CERTIFICATE=$(MailEximTransportOption remote_smtp_smarthost tls_certificate)
                    EXIM_PRIVATEKEY=$(MailEximTransportOption remote_smtp_smarthost tls_privatekey)
                    ;;
            esac

            # Values may be expansion strings, e.g. ${if exists{...}{...}}. A file test is not possible then
            if [ -n "${EXIM_CERTIFICATE}" ]; then
                LogText "Result: ${EXIM_CERTIFICATE}"
                case "${EXIM_CERTIFICATE}" in
                    *'$'*)
                        LogText "Result: certificate is an expansion string, file test skipped"
                        Display --indent 4 --text "- Certificate" --result "DYNAMIC" --color WHITE
                        ;;
                    *)
                        if [ -f "${EXIM_CERTIFICATE}" ]; then
                            Display --indent 4 --text "- Certificate" --result "${STATUS_FOUND}" --color GREEN
                            LogText "Result: Certificate found"
                            Report "mail_certificate[]=exim|${EXIM_CERTIFICATE}"
                        else
                            Display --indent 4 --text "- Certificate" --result "${STATUS_NOT_FOUND}" --color RED
                            LogText "Result: Certificate not found"
                            ReportWarning "${TEST_NO}" "Configured Exim certificate does not exist" "${EXIM_CERTIFICATE}" "-"
                        fi
                        ;;
                esac
            else
                LogText "Result: Certificate not set"
                Display --indent 4 --text "- Certificate" --result "${STATUS_NOT_CONFIGURED}" --color WHITE
            fi

            if [ -n "${EXIM_PRIVATEKEY}" ]; then
                LogText "Result: ${EXIM_PRIVATEKEY}"
                case "${EXIM_PRIVATEKEY}" in
                    *'$'*)
                        LogText "Result: private key is an expansion string, file test skipped"
                        Display --indent 4 --text "- Private Key" --result "DYNAMIC" --color WHITE
                        ;;
                    *)
                        if [ -f "${EXIM_PRIVATEKEY}" ]; then
                            LogText "Result: Private Key found"
                            Display --indent 4 --text "- Private Key" --result "${STATUS_FOUND}" --color GREEN
                            MailCheckPrivateKey "${TEST_NO}" "Exim" "${EXIM_PRIVATEKEY}" 6
                        else
                            Display --indent 4 --text "- Private Key" --result "${STATUS_NOT_FOUND}" --color RED
                            LogText "Result: Private Key not found"
                            ReportWarning "${TEST_NO}" "Configured Exim private key does not exist" "${EXIM_PRIVATEKEY}" "-"
                        fi
                        ;;
                esac
            else
                LogText "Result: Private Key not set"
                Display --indent 4 --text "- Private Key" --result "${STATUS_NOT_CONFIGURED}" --color WHITE
            fi

            LogText "Test: Exim Verify Certificates"

            # Note: the option is called tls_verify_certificates (plural), both as main and as transport option
            case "${EXIM_TYPE}" in
                "INTERNET HOST" | "SMARTHOST" )
                    EXIM_CERTIFICATES=$(MailEximOption tls_verify_certificates)
                    ;;
                "SATELLITE" )
                    EXIM_CERTIFICATES=$(MailEximTransportOption remote_smtp_smarthost tls_verify_certificates)
                    ;;
            esac

            case "${EXIM_CERTIFICATES}" in
                "")
                    LogText "Result: Verify Certificates not set"
                    Display --indent 4 --text "- Verify Certificates not set" --result "${STATUS_WARNING}" --color RED
                    ReportSuggestion "${TEST_NO}" "Set tls_verify_certificates so peer certificates can be verified" "tls_verify_certificates=" "text:Use tls_verify_certificates = system"
                    ;;
                "system")
                    # This is the default setting and should be the most common
                    LogText "Result: Verify Certificates set to system default"
                    Display --indent 4 --text "- Verify Certificates" --result "${STATUS_DEFAULT}" --color WHITE
                    ;;
                *)
                    # This condition should only be hit when it has been set to a custom value
                    LogText "Result: Verify Certificates set to \"${EXIM_CERTIFICATES}\""
                    Display --indent 4 --text "- Verify Certificates" --result "CUSTOM" --color GREEN
                    ;;
            esac

            case "${EXIM_TYPE}" in
                "INTERNET HOST" | "SMARTHOST" )
                    EXIM_VERIFY_HOSTS=$(MailEximOption tls_verify_hosts)
                    EXIM_TRY_VERIFY_HOSTS=$(MailEximOption tls_try_verify_hosts)
                    ;;
                "SATELLITE" )
                    EXIM_VERIFY_HOSTS=$(MailEximTransportOption remote_smtp_smarthost tls_verify_hosts)
                    EXIM_TRY_VERIFY_HOSTS=$(MailEximTransportOption remote_smtp_smarthost tls_try_verify_hosts)
                    ;;
            esac

            LogText "Test: Exim Try Verify Hosts"
            if [ -n "${EXIM_TRY_VERIFY_HOSTS}" ]; then
                LogText "Result: Try Verify Hosts enabled"
                case "${EXIM_TYPE}" in
                    "INTERNET HOST" )
                        Display --indent 4 --text "- Try Verify Hosts" --result "${STATUS_ENABLED}" --color GREEN
                        ;;
                    "SATELLITE" | "SMARTHOST" )
                        Display --indent 4 --text "- Try Verify Hosts" --result "${STATUS_ENABLED}" --color YELLOW
                        ;;
                esac
            else
                LogText "Result: Try Verify Hosts not enabled"
                Display --indent 4 --text "- Try Verify Hosts" --result "${STATUS_DISABLED}" --color WHITE
            fi

            LogText "Test: Exim Verify Hosts"
            if [ -n "${EXIM_VERIFY_HOSTS}" ]; then
                LogText "Result: Verify Hosts enabled"
                case "${EXIM_TYPE}" in
                    "INTERNET HOST" )
                        Display --indent 4 --text "- Verify Hosts" --result "${STATUS_ENABLED}" --color YELLOW
                        ;;
                    "SATELLITE" | "SMARTHOST" )
                        Display --indent 4 --text "- Verify Hosts" --result "${STATUS_ENABLED}" --color GREEN
                        ;;
                esac
            else
                LogText "Result: Verify Hosts not enabled"
                Display --indent 4 --text "- Verify Hosts" --result "${STATUS_DISABLED}" --color WHITE
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8806
    # Description : Check Exim SMTP banner for information disclosure
    if [ ${EXIM_RUNNING} -eq 1 -a -n "${EXIMBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8806 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check Exim configuration: banner"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: Checking Exim banner"
        EXIM_BANNER=$(MailEximOption smtp_banner)
        LogText "Result: smtp_banner = ${EXIM_BANNER}"
        SHOWWARNING=0
        FIND=$(echo "${EXIM_BANNER}" | ${GREPBINARY} -iE 'exim|version_number')
        if [ -n "${FIND}" ]; then
            SHOWWARNING=1
            Report "banner_software_disclosure[]=smtp_banner = ${EXIM_BANNER}"
        fi
        FIND=$(echo "${EXIM_BANNER}" | ${GREPBINARY} -i "${OS}")
        if [ -z "${FIND}" -a -n "${LINUX_VERSION}" ]; then FIND=$(echo "${EXIM_BANNER}" | ${GREPBINARY} -i "${LINUX_VERSION}"); fi
        if [ -n "${FIND}" ]; then
            SHOWWARNING=1
            Report "banner_os_disclosure[]=smtp_banner = ${EXIM_BANNER}"
        fi
        if [ ${SHOWWARNING} -eq 1 ]; then
            Display --indent 4 --text "- Exim banner" --result "${STATUS_WARNING}" --color RED
            LogText "Result: found software name, version or OS in the Exim SMTP banner"
            ReportWarning "${TEST_NO}" "Found some information disclosure in SMTP banner (OS or software name)" "smtp_banner=${EXIM_BANNER}" "-"
            ReportSuggestion "${TEST_NO}" "Hide the software name and version in the Exim banner" "-" "text:Set smtp_banner = \$smtp_active_hostname ESMTP"
            AddHP 0 1
        else
            if IsVerbose; then Display --indent 4 --text "- Exim banner" --result "${STATUS_OK}" --color GREEN; fi
            AddHP 1 1
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8814
    # Description : Check Postfix process
    # Notes       : qmgr and pickup run under postfix uid, without full path to binary
    Register --test-no MAIL-8814 --weight L --network NO --category security --description "Check postfix process status"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: check Postfix status"
        # Some other processes also use master, therefore it should include both master and postfix
        FIND1=$(${PSBINARY} ax | ${GREPBINARY} "master" | ${GREPBINARY} "postfix" | ${GREPBINARY} -v "grep")
        if [ -n "${FIND1}" ]; then
            LogText "Result: found running Postfix process"
            Display --indent 2 --text "- Postfix status" --result "${STATUS_RUNNING}" --color GREEN
            POSTFIX_RUNNING=1
            MailAddMTA "postfix"
            # Read the full configuration once, the next tests use this data
            if [ -n "${POSTCONFBINARY}" ]; then POSTFIX_SETTINGS=$(${POSTCONFBINARY} 2> /dev/null); fi
        else
            LogText "Result: no running Postfix processes found"
            if IsVerbose; then Display --indent 2 --text "- Postfix status" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8816
    # Description : Check Postfix configuration
    if [ ${POSTFIX_RUNNING} -eq 1 -a -n "${POSTCONFBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8816 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check Postfix configuration"
    if [ ${SKIPTEST} -eq 0 ]; then
        POSTFIX_CONFIGDIR=$(MailPostfixValue config_directory)
        POSTFIX_CONFIGFILE="${POSTFIX_CONFIGDIR}/main.cf"
        LogText "Postfix configuration directory: ${POSTFIX_CONFIGDIR}"
        LogText "Postfix configuration file: ${POSTFIX_CONFIGFILE}"
        if [ -f "${POSTFIX_CONFIGFILE}" ]; then
            Display --indent 4 --text "- Postfix configuration" --result "${STATUS_FOUND}" --color GREEN
        else
            Display --indent 4 --text "- Postfix configuration" --result "${STATUS_NOT_FOUND}" --color YELLOW
            LogText "Result: configuration file ${POSTFIX_CONFIGFILE} does not exist"
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8817
    # Description : Check Postfix configuration for error
    if [ ${POSTFIX_RUNNING} -eq 1 -a -n "${POSTCONFBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8817 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check Postfix configuration errors"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: using postconf to see if Postfix configuration has errors"
        FIND=$(${POSTCONFBINARY} 2>&1 | ${GREPBINARY} "warning:")
        # 'postfix check' also validates ownership and permissions of files and directories
        if [ -n "${POSTFIXBINARY}" ]; then
            FIND2=$(${POSTFIXBINARY} check 2>&1 | ${GREPBINARY} -E "warning:|fatal:")
        else
            FIND2=""
        fi
        if [ -n "${FIND}" -o -n "${FIND2}" ]; then
            Report "postfix_config_error=1"
            Display --indent 6 --text "- Postfix configuration errors" --result "${STATUS_WARNING}" --color RED
            LogText "Result: found an error or warning in the Postfix configuration. Manual check suggested."
            LogText "Output: ${FIND} ${FIND2}"
            ReportSuggestion "${TEST_NO}" "Found a configuration error in Postfix" "${POSTFIX_CONFIGFILE}" "text:run postconf > /dev/null and postfix check"
        else
            LogText "Result: all looks to be fine with Postfix configuration"
            if IsVerbose; then Display --indent 6 --text "- Postfix configuration errors" --result "${STATUS_OK}" --color GREEN; fi
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8818
    # Description : Check Postfix configuration
    if [ ${POSTFIX_RUNNING} -eq 1 -a -n "${POSTCONFBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8818 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check Postfix configuration: banner"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: Checking Postfix banner"
        POSTFIX_BANNER=$(MailPostfixValue smtpd_banner)
        POSTFIX_MAILNAME=$(MailPostfixValue mail_name)
        LogText "Result: smtpd_banner = ${POSTFIX_BANNER}"
        SHOWWARNING=0

        # Each type of disclosure is reported, instead of only the first one found
        FIND1=$(echo "${POSTFIX_BANNER}" | ${GREPBINARY} -i 'postfix')
        FIND2=$(echo "${POSTFIX_BANNER}" | ${GREPBINARY} -E '\$(mail_name|\{mail_name\}|\(mail_name\))')
        FIND3=$(echo "${POSTFIX_MAILNAME}" | ${GREPBINARY} -i 'postfix')
        FIND4=$(echo "${POSTFIX_BANNER}" | ${GREPBINARY} -E '\$(mail_version|\{mail_version\}|\(mail_version\))')
        FIND5=$(echo "${POSTFIX_BANNER}" | ${GREPBINARY} -i "${OS}")
        if [ -n "${LINUX_VERSION}" ]; then
            FIND6=$(echo "${POSTFIX_BANNER}" | ${GREPBINARY} -i "${LINUX_VERSION}")
        else
            FIND6=""
        fi

        if [ -n "${FIND1}" ] || [ -n "${FIND2}" -a -n "${FIND3}" ]; then
            SHOWWARNING=1
            LogText "Result: banner shows the software name"
            Report "banner_software_disclosure[]=smtpd_banner = ${POSTFIX_BANNER}"
        fi
        if [ -n "${FIND4}" ]; then
            SHOWWARNING=1
            LogText "Result: banner shows the software version (\$mail_version)"
            Report "banner_version_disclosure[]=smtpd_banner = ${POSTFIX_BANNER}"
        fi
        if [ -n "${FIND5}" -o -n "${FIND6}" ]; then
            SHOWWARNING=1
            LogText "Result: banner shows the operating system or distribution"
            Report "banner_os_disclosure[]=smtpd_banner = ${POSTFIX_BANNER}"
        fi

        if [ ${SHOWWARNING} -eq 1 ]; then
            Display --indent 6 --text "- Postfix banner" --result "${STATUS_WARNING}" --color RED
            LogText "Result: found OS, or mail_name in SMTP banner, and/or mail_name contains 'Postfix'."
            ReportWarning "${TEST_NO}" "Found some information disclosure in SMTP banner (OS or software name)" "smtpd_banner=${POSTFIX_BANNER}" "-"
            ReportSuggestion "${TEST_NO}" "You are advised to hide the mail_name (option: smtpd_banner) from your postfix configuration. Use postconf -e or change your main.cf file (${POSTFIX_CONFIGFILE})" "-" "text:run postconf -e 'smtpd_banner=\$myhostname ESMTP'"
            AddHP 0 1
        else
            if IsVerbose; then Display --indent 6 --text "- Postfix banner" --result "${STATUS_OK}" --color GREEN; fi
            AddHP 1 1
        fi
    fi
#
#################################################################################
#
    # Test        : MAIL-8820
    # Description : Postfix configuration scan (atomic tests)
    if [ ${POSTFIX_RUNNING} -eq 1 -a -n "${POSTCONFBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8820 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Postfix configuration scan"
