                Display --indent 4 --text "- Dovecot SSL" --result "REQUIRED" --color GREEN
                AddHP 3 3
                ;;
            "yes")
                Display --indent 4 --text "- Dovecot SSL" --result "${STATUS_ENABLED}" --color GREEN
                AddHP 2 3
                ;;
            *)
                Display --indent 4 --text "- Dovecot SSL" --result "${STATUS_DISABLED}" --color RED
                ReportWarning "${TEST_NO}" "Dovecot SSL/TLS is disabled, mail and passwords are sent unencrypted" "ssl=${DOVECOT_SSL}" "text:Set ssl = required in 10-ssl.conf"
                AddHP 0 3
                ;;
        esac

        # Dovecot 2.3 uses disable_plaintext_auth, Dovecot 2.4 renamed it to auth_allow_cleartext
        LogText "Test: checking if Dovecot allows plaintext authentication without SSL/TLS"
        DOVECOT_PLAIN=$(${DOVECONFBINARY} -h disable_plaintext_auth 2> /dev/null)
        DOVECOT_CLEARTEXT=$(${DOVECONFBINARY} -h auth_allow_cleartext 2> /dev/null)
        LogText "Result: disable_plaintext_auth = ${DOVECOT_PLAIN}, auth_allow_cleartext = ${DOVECOT_CLEARTEXT}"
        if [ "${DOVECOT_PLAIN}" = "no" -o "${DOVECOT_CLEARTEXT}" = "yes" ]; then
            Display --indent 4 --text "- Dovecot plaintext authentication" --result "${STATUS_ENABLED}" --color RED
            ReportWarning "${TEST_NO}" "Dovecot allows plaintext authentication on unencrypted connections" "-" "text:Set disable_plaintext_auth = yes (2.3) or auth_allow_cleartext = no (2.4)"
            AddHP 0 3
        else
            Display --indent 4 --text "- Dovecot plaintext authentication" --result "${STATUS_DISABLED}" --color GREEN
            AddHP 3 3
        fi

        if [ ! "${DOVECOT_SSL}" = "no" ]; then
            DOVECOT_MINPROTO=$(${DOVECONFBINARY} -h ssl_min_protocol 2> /dev/null)
            LogText "Result: ssl_min_protocol = ${DOVECOT_MINPROTO}"
            case "${DOVECOT_MINPROTO}" in
                "SSLv3" | "TLSv1" | "TLSv1.1")
                    Display --indent 4 --text "- Dovecot minimum TLS protocol" --result "${STATUS_WEAK}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "Do not allow protocols older than TLS 1.2 in Dovecot" "ssl_min_protocol=${DOVECOT_MINPROTO}" "text:Set ssl_min_protocol = TLSv1.2"
                    AddHP 0 1
                    ;;
                *)
                    Display --indent 4 --text "- Dovecot minimum TLS protocol" --result "${DOVECOT_MINPROTO:-${STATUS_DEFAULT}}" --color GREEN
                    AddHP 1 1
                    ;;
            esac

            # ssl_key (2.3) uses "<" to read from a file, Dovecot 2.4 uses ssl_server_key_file
            DOVECOT_KEY=$(${DOVECONFBINARY} -h ssl_key 2> /dev/null | ${SEDBINARY} 's/^<//')
            if [ -z "${DOVECOT_KEY}" ]; then DOVECOT_KEY=$(${DOVECONFBINARY} -h ssl_server_key_file 2> /dev/null); fi
            DOVECOT_CERT=$(${DOVECONFBINARY} -h ssl_cert 2> /dev/null | ${SEDBINARY} 's/^<//')
            if [ -z "${DOVECOT_CERT}" ]; then DOVECOT_CERT=$(${DOVECONFBINARY} -h ssl_server_cert_file 2> /dev/null); fi
            if [ -n "${DOVECOT_CERT}" -a -f "${DOVECOT_CERT}" ]; then Report "mail_certificate[]=dovecot|${DOVECOT_CERT}"; fi
            if [ -n "${DOVECOT_KEY}" ]; then
                LogText "Result: private key = ${DOVECOT_KEY}"
                MailCheckPrivateKey "${TEST_NO}" "Dovecot" "${DOVECOT_KEY}" 4
            fi
        fi
    fi
