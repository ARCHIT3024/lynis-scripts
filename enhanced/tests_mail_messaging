#################################################################################
#
    # Test        : MAIL-8824
    # Description : Check Postfix TLS configuration
    if [ ${POSTFIX_RUNNING} -eq 1 -a -n "${POSTCONFBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-8824 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check Postfix TLS configuration"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: checking Postfix TLS for incoming mail"
        POSTFIX_TLS_LEVEL=$(MailPostfixValue smtpd_tls_security_level)
        # Legacy setting, replaced by smtpd_tls_security_level
        if [ -z "${POSTFIX_TLS_LEVEL}" -a "$(MailPostfixValue smtpd_use_tls)" = "yes" ]; then POSTFIX_TLS_LEVEL="may"; fi
        LogText "Result: smtpd_tls_security_level = ${POSTFIX_TLS_LEVEL}"
        case "${POSTFIX_TLS_LEVEL}" in
            "may" | "encrypt")
                Display --indent 6 --text "- Postfix TLS (incoming)" --result "${STATUS_ENABLED}" --color GREEN
                AddHP 3 3

                # The key defaults to $smtpd_tls_cert_file, so let postconf expand it (-x)
                POSTFIX_TLS_CERT=$(${POSTCONFBINARY} -xh smtpd_tls_cert_file 2> /dev/null)
                POSTFIX_TLS_KEY=$(${POSTCONFBINARY} -xh smtpd_tls_key_file 2> /dev/null)
                if [ -n "${POSTFIX_TLS_CERT}" ]; then
                    if [ -f "${POSTFIX_TLS_CERT}" ]; then
                        LogText "Result: certificate ${POSTFIX_TLS_CERT} found"
                        Report "mail_certificate[]=postfix|${POSTFIX_TLS_CERT}"
                    else
                        Display --indent 8 --text "- Certificate" --result "${STATUS_NOT_FOUND}" --color RED
                        ReportWarning "${TEST_NO}" "Configured Postfix certificate does not exist" "${POSTFIX_TLS_CERT}" "-"
                    fi
                fi
                if [ -n "${POSTFIX_TLS_KEY}" ]; then MailCheckPrivateKey "${TEST_NO}" "Postfix" "${POSTFIX_TLS_KEY}" 8; fi
                ;;
            *)
                Display --indent 6 --text "- Postfix TLS (incoming)" --result "${STATUS_DISABLED}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Enable TLS for incoming SMTP connections" "smtpd_tls_security_level=${POSTFIX_TLS_LEVEL}" "text:run postconf -e smtpd_tls_security_level=may"
                AddHP 0 3
                ;;
        esac

        # Mandatory TLS (e.g. submission with smtpd_tls_security_level=encrypt) should not allow old protocols
        # Note: smtpd_tls_protocols (opportunistic TLS) is only logged. Disabling old protocols there may cause plaintext delivery
        LogText "Test: checking protocols for mandatory TLS"
        POSTFIX_TLS_PROTOCOLS=$(MailPostfixValue smtpd_tls_mandatory_protocols)
        LogText "Result: smtpd_tls_mandatory_protocols = ${POSTFIX_TLS_PROTOCOLS}"
        LogText "Result: smtpd_tls_protocols = $(MailPostfixValue smtpd_tls_protocols)"
        POSTFIX_TLS_WEAK=0
        case "${POSTFIX_TLS_PROTOCOLS}" in
            *">=TLSv1.2"* | *">=TLSv1.3"*)
                POSTFIX_TLS_WEAK=0
                ;;
            *">="*)
                POSTFIX_TLS_WEAK=1
                ;;
            *"!"*)
                # Exclusion syntax: all old protocols should be listed
                for PATTERN in '!SSLv2' '!SSLv3' '!TLSv1([^.]|$)' '!TLSv1\.1'; do
                    FIND=$(echo "${POSTFIX_TLS_PROTOCOLS}" | ${GREPBINARY} -E "${PATTERN}")
                    if [ -z "${FIND}" ]; then POSTFIX_TLS_WEAK=1; fi
                done
                ;;
            "")
                LogText "Result: protocols are determined by the TLS library defaults"
                ;;
            *)
                # Inclusion syntax, like "TLSv1.2 TLSv1.3"
                FIND=$(echo "${POSTFIX_TLS_PROTOCOLS}" | ${GREPBINARY} -E 'SSLv|TLSv1([^.]|$)|TLSv1\.1')
                if [ -n "${FIND}" ]; then POSTFIX_TLS_WEAK=1; fi
                ;;
        esac
        if [ ${POSTFIX_TLS_WEAK} -eq 1 ]; then
            Display --indent 6 --text "- Postfix mandatory TLS protocols" --result "${STATUS_WEAK}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "Do not allow SSLv3, TLS 1.0 or TLS 1.1 for mandatory TLS" "smtpd_tls_mandatory_protocols=${POSTFIX_TLS_PROTOCOLS}" "text:run postconf -e 'smtpd_tls_mandatory_protocols=>=TLSv1.2'"
            AddHP 0 1
        else
            Display --indent 6 --text "- Postfix mandatory TLS protocols" --result "${STATUS_OK}" --color GREEN
            AddHP 1 1
        fi

        # SMTP AUTH should only be offered on encrypted sessions
        if [ "$(MailPostfixValue smtpd_sasl_auth_enable)" = "yes" ]; then
            if [ "$(MailPostfixValue smtpd_tls_auth_only)" = "yes" ]; then
                Display --indent 6 --text "- Postfix SMTP AUTH only over TLS" --result "${STATUS_YES}" --color GREEN
                AddHP 2 2
            else
                Display --indent 6 --text "- Postfix SMTP AUTH only over TLS" --result "${STATUS_NO}" --color RED
                ReportWarning "${TEST_NO}" "Postfix allows SMTP AUTH on unencrypted connections" "smtpd_tls_auth_only=no" "text:run postconf -e smtpd_tls_auth_only=yes"
                AddHP 0 2
            fi
        fi

        LogText "Test: checking Postfix TLS for outgoing mail"
        POSTFIX_TLS_OUT=$(MailPostfixValue smtp_tls_security_level)
        LogText "Result: smtp_tls_security_level = ${POSTFIX_TLS_OUT}"
        case "${POSTFIX_TLS_OUT}" in
            "" | "none")
                Display --indent 6 --text "- Postfix TLS (outgoing)" --result "${STATUS_DISABLED}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Use TLS when delivering mail to other servers" "smtp_tls_security_level=${POSTFIX_TLS_OUT}" "text:run postconf -e smtp_tls_security_level=may"
                AddHP 0 1
                ;;
            *)
                Display --indent 6 --text "- Postfix TLS (outgoing)" --result "${STATUS_ENABLED}" --color GREEN
                AddHP 1 1
                ;;
        esac
    fi
