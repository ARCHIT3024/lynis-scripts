#################################################################################
#
    # Test        : MAIL-9040
    # Description : Check for unencrypted mail protocols reachable over the network
    # Notes       : Ports 110 (POP3) and 143 (IMAP) are plaintext, unless the client uses STARTTLS
    if [ -n "${SSBINARY}" -o -n "${NETSTATBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-9040 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check for unencrypted mail protocols on the network"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: collecting listening mail ports (not on loopback)"
        if [ -n "${SSBINARY}" ]; then
            MH_LISTEN=$(${SSBINARY} -ltnH 2> /dev/null | ${AWKBINARY} '{ print $4 }')
        else
            MH_LISTEN=$(${NETSTATBINARY} -ltn 2> /dev/null | ${AWKBINARY} '$1 ~ /^tcp/ { print $4 }')
        fi
        MH_PORTS=$(echo "${MH_LISTEN}" | ${GREPBINARY} -vE '^(127\.|\[::1\]|::1)' | ${SEDBINARY} 's/.*[:.]//' | ${GREPBINARY} -E '^(25|110|143|465|587|993|995)$' | ${SORTBINARY} -n -u | ${TRBINARY} '\n' ' ' | ${SEDBINARY} 's/ $//')
        LogText "Result: mail ports reachable from the network: ${MH_PORTS:-none}"
        for PORT in ${MH_PORTS}; do Report "mail_listening_port[]=${PORT}"; done
        Display --indent 2 --text "- Mail ports on network" --result "${MH_PORTS:-${STATUS_NONE}}" --color WHITE

        MH_PLAIN=""
        for PORT in ${MH_PORTS}; do
            case "${PORT}" in
                110) MH_PLAIN="${MH_PLAIN}${MH_PLAIN:+ }110/pop3" ;;
                143) MH_PLAIN="${MH_PLAIN}${MH_PLAIN:+ }143/imap" ;;
            esac
        done
        if [ -n "${MH_PLAIN}" ]; then
            # With Dovecot ssl=required, clients must use STARTTLS before doing anything
            MH_SSLREQ=""
            if [ ${MH_DOVECOT} -eq 1 -a -n "${MH_DOVECONFBINARY}" ]; then MH_SSLREQ=$(${MH_DOVECONFBINARY} -h ssl 2> /dev/null); fi
            if [ "${MH_SSLREQ}" = "required" ]; then
                LogText "Result: plaintext ports open, but Dovecot requires STARTTLS (ssl = required)"
                Display --indent 2 --text "- Unencrypted POP3/IMAP" --result "STARTTLS REQUIRED" --color GREEN
                AddHP 2 2
            else
                LogText "Result: unencrypted POP3/IMAP ports reachable: ${MH_PLAIN}"
                Display --indent 2 --text "- Unencrypted POP3/IMAP" --result "${STATUS_EXPOSED}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "POP3/IMAP without TLS is reachable from the network, prefer POP3S/IMAPS (995/993) or require STARTTLS" "${MH_PLAIN}" "text:Dovecot: set ssl = required, or disable the plaintext listeners (port = 0)"
                AddHP 0 2
            fi
        else
            AddHP 2 2
        fi
    fi
