#################################################################################
#
    # Test        : MAIL-9050
    # Description : Check mail log files
    # Notes       : Mail logs are needed for incident handling, but contain personal data (addresses)
    if [ ${MH_MTA} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-9050 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check mail log files"
    if [ ${SKIPTEST} -eq 0 ]; then
        MH_LOGS=""
        MH_LOGFILES="/var/log/mail.log /var/log/maillog /var/log/mail /var/log/exim4/mainlog /var/log/exim/main.log /var/log/exim_mainlog"
        # Postfix 3.4 and later can log to a file directly
        if [ ${MH_POSTFIX} -eq 1 ]; then
            FILE=$(${POSTCONFBINARY} -xh maillog_file 2> /dev/null)
            case "${FILE}" in
                /dev/stdout | /dev/stderr) LogText "Result: Postfix logs to ${FILE}" ;;
                "") ;;
                *) MH_LOGFILES="${FILE} ${MH_LOGFILES}" ;;
            esac
        fi
        for FILE in ${MH_LOGFILES}; do
            case " ${MH_LOGS} " in
                *" ${FILE} "*) ;;
                *) if [ -f "${FILE}" ]; then MH_LOGS="${MH_LOGS}${MH_LOGS:+ }${FILE}"; fi ;;
            esac
        done
        if [ -z "${MH_LOGS}" ]; then
            LogText "Result: no mail log file found"
            Display --indent 2 --text "- Mail log file" --result "${STATUS_NOT_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "No mail log file found, make sure the MTA logs to syslog, journald or a file" "-" "text:Install a syslog daemon (e.g. rsyslog), or set maillog_file in Postfix"
            AddHP 0 1
        else
            LogText "Result: found mail log file(s): ${MH_LOGS}"
            Display --indent 2 --text "- Mail log file" --result "${STATUS_FOUND}" --color GREEN
            AddHP 1 1
            MH_LOGS_OPEN=""
            for FILE in ${MH_LOGS}; do
                Report "mail_log_file[]=${FILE}"
                PERMS=$(MhOtherPerms "${FILE}" | ${CUTBINARY} -c 1)
                if [ "${PERMS}" = "r" ]; then MH_LOGS_OPEN="${MH_LOGS_OPEN}${MH_LOGS_OPEN:+ }${FILE}"; fi
            done
            if [ -n "${MH_LOGS_OPEN}" ]; then
                Display --indent 2 --text "- Mail log permissions" --result "${STATUS_UNSAFE}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Mail log files are readable by all users and disclose who mails with whom" "${MH_LOGS_OPEN}" "text:Run chmod o-r on the log file and check the logrotate create mode"
                AddHP 0 1
            else
                Display --indent 2 --text "- Mail log permissions" --result "${STATUS_OK}" --color GREEN
                AddHP 1 1
            fi
        fi
    fi
