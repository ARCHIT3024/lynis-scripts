#################################################################################
#
    # Test        : MAIL-9060
    # Description : Check for DKIM/DMARC and spam/virus filtering on an MTA that receives mail from the network
    if [ ${MH_MTA_EXPOSED} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MAIL-9060 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check for DKIM/DMARC and spam/virus filtering"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: searching for mail authentication (DKIM/DMARC) software"
        MH_AUTH=""
        for PROCESS in opendkim opendmarc rspamd; do
            if IsRunning "${PROCESS}"; then MH_AUTH="${MH_AUTH}${MH_AUTH:+ }${PROCESS}"; fi
        done
        # Exim has DKIM built in, signing is enabled with dkim_domain on the smtp transport
        if [ ${MH_EXIM} -eq 1 ]; then
            FIND=$(${EXIMBINARY} -bP transport remote_smtp 2> /dev/null | ${GREPBINARY} -E '^[[:space:]]*dkim_domain = .+')
            if [ -n "${FIND}" ]; then MH_AUTH="${MH_AUTH}${MH_AUTH:+ }exim-dkim"; fi
        fi
        if [ -n "${MH_AUTH}" ]; then
            LogText "Result: found ${MH_AUTH}"
            Display --indent 2 --text "- DKIM/DMARC" --result "${STATUS_FOUND}" --color GREEN
            AddHP 2 2
        else
            LogText "Result: no DKIM signing or DMARC verification found"
            Display --indent 2 --text "- DKIM/DMARC" --result "${STATUS_NOT_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "No DKIM signing or DMARC verification found, mail from this domain is easier to spoof" "-" "text:Install OpenDKIM/OpenDMARC or rspamd, and publish SPF, DKIM and DMARC records in DNS"
            AddHP 0 2
        fi

        LogText "Test: searching for spam and virus filtering"
        MH_FILTER=""
        for PROCESS in rspamd spamd amavisd amavisd-new clamd spampd; do
            if IsRunning "${PROCESS}"; then MH_FILTER="${MH_FILTER}${MH_FILTER:+ }${PROCESS}"; fi
        done
        # Postfix: content filter or milters (e.g. a remote rspamd)
        if [ ${MH_POSTFIX} -eq 1 ]; then
            FIND=$(${POSTCONFBINARY} -xh smtpd_milters content_filter 2> /dev/null | ${GREPBINARY} -v '^$')
            if [ -n "${FIND}" ]; then MH_FILTER="${MH_FILTER}${MH_FILTER:+ }postfix-filter"; fi
        fi
        if [ -n "${MH_FILTER}" ]; then
            LogText "Result: found ${MH_FILTER}"
            Display --indent 2 --text "- Spam/virus filtering" --result "${STATUS_FOUND}" --color GREEN
            AddHP 2 2
        else
            LogText "Result: no spam or virus filtering found"
            Display --indent 2 --text "- Spam/virus filtering" --result "${STATUS_NOT_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "No spam or virus filtering found for incoming mail" "-" "text:Use rspamd, SpamAssassin or amavis with ClamAV"
            AddHP 0 2
        fi
    fi
